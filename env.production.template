# ===========================================================================
# SmarThinkerz Marketing Suite — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (development) or set these as environment
# variables in your host (production), then fill in the values.
#
# The application runs in a fully navigable "setup mode" until the required
# keys are present, so you can build and explore the UI before wiring services.
# Each integration degrades gracefully and surfaces a clear setup notice
# instead of crashing or showing fabricated data.
# ===========================================================================

# --- App identity ----------------------------------------------------------
# Controls the product name shown in the header, footer, emails, and metadata.
# The final word receives the gradient accent (e.g., "SmarThinkerz Marketing Suite").
NEXT_PUBLIC_APP_NAME="SmarThinkerz Marketing Suite"
# Public base URL of the deployment (used for emails, redirects, metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase: Auth + Postgres + Storage + RLS  (REQUIRED) -----------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Never exposed to the browser. Used by the webhook to provision
# plans with elevated privileges. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- OpenAI: powers the 10 AI marketing tools  (REQUIRED for AI) -----------
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_IMAGE_MODEL="dall-e-3"

# --- Billing: generic hosted Payment Hub  (REQUIRED for live billing) ------
# This product NEVER touches card data and integrates no card processor
# directly. An external, hosted Payment Hub renders checkout and sends a
# signed webhook back to /api/webhooks/payment-hub on success/failure/cancel.
#
# You only need the shared webhook secret (identical value on both sides) and
# the hosted checkout URL. Everything here is brand-neutral and configurable.
#
# Shared HMAC secret used to verify webhook authenticity (constant-time).
PAYMENT_HUB_WEBHOOK_SECRET="shared-secret-generated-in-your-payment-hub"
# An identifier your hub uses to associate charges with this product.
PAYMENT_HUB_PRODUCT_KEY="SmarThinkerz Marketing Suite"
# The hosted checkout page base URL (buyers are sent here to pay).
NEXT_PUBLIC_PAYMENT_HUB_CHECKOUT_URL="https://your-payment-hub.example.com/checkout"
# Optional: where the hub returns buyers after payment (HTTPS, allowlisted).
NEXT_PUBLIC_PAYMENT_HUB_RETURN_URL="https://your-domain.com/dashboard/billing?status=success"

# --- Resend: transactional email  (REQUIRED for emails) --------------------
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="SmarThinkerz Marketing Suite <noreply@yourdomain.com>"
